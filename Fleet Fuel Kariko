<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Fleet Fuel AI Enterprise</title>
<meta name="theme-color" content="#0f172a">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Fleet Fuel AI">
<link id="appleIcon" rel="apple-touch-icon">
<link id="pwaManifest" rel="manifest">
<script src="https://jsdelivr.net"></script>
<style>
*{box-sizing:border-box;font-family:system-ui,-apple-system,sans-serif;-webkit-tap-highlight-color:transparent}
body{margin:0;background:#f1f5f9;padding:12px;padding-bottom:105px;user-select:none;color:#0f172a}
h1{font-size:20px;text-align:center;margin:6px 0 2px}
h2{font-size:16px;margin:0 0 8px}
.sub{text-align:center;color:#64748b;font-size:12px;margin-bottom:12px}
.card{background:#fff;border-radius:16px;padding:14px;margin-bottom:12px;box-shadow:0 2px 10px rgba(0,0,0,.06)}
label{font-size:13px;color:#475569;display:block;margin-top:10px;font-weight:600}
input,select,textarea{width:100%;padding:12px;border:1px solid #cbd5e1;border-radius:10px;margin-top:4px;font-size:16px;background:#fff;user-select:text}
input:focus,select:focus,textarea:focus{outline:none;border-color:#2563eb}
input[type="checkbox"]{width:20px;height:20px;margin:0;accent-color:#16a34a}
.check-row{display:flex;align-items:center;gap:10px;margin-top:12px;padding:10px;background:#f8fafc;border-radius:10px;border:1px solid #e2e8f0;cursor:pointer}
.check-row span{font-size:14px;font-weight:700;color:#0f172a}
.check-row small{display:block;font-size:12px;color:#64748b;font-weight:400}
button{width:100%;padding:13px;border:0;border-radius:12px;font-size:15px;font-weight:700;margin-top:10px;cursor:pointer}
button:active{transform:scale(.99)}
.btn-black{background:#0f172a;color:#fff}
.btn-green{background:#16a34a;color:#fff}
.btn-wa{background:#25d366;color:#0f172a}
.btn-blue{background:#2563eb;color:#fff}
.btn-orange{background:#ea580c;color:#fff}
.btn-red{background:#dc2626;color:#fff}
.btn-yellow{background:#facc15;color:#0f172a}
.btn-scan{background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff;display:flex;align-items:center;justify-content:center;gap:8px;padding:14px;border-radius:12px;font-weight:700;font-size:15px;margin-top:6px;cursor:pointer;box-shadow:0 4px 12px rgba(37,99,235,.25)}
.btn-sm{width:auto;padding:6px 10px;font-size:12px;border-radius:8px;margin:0}
.row{display:flex;gap:8px}.row>*{flex:1}
.stat{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;padding:10px 0;border-bottom:1px solid #f1f5f9;font-size:14px}
.stat:last-child{border-bottom:0}
.kpi{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px}
.kpi div{background:#0f172a;color:#fff;border-radius:14px;padding:12px}
.kpi small{opacity:.8;font-size:12px}.kpi b{font-size:20px;display:block;margin-top:2px}
.badge{background:#fef9c3;padding:3px 8px;border-radius:20px;font-size:11px;font-weight:800;color:#854d0e;display:inline-block}
.badge-green{background:#dcfce7;color:#166534}
.badge-blue{background:#dbeafe;color:#1e40af}
.badge-red{background:#fee2e2;color:#991b1b}
.badge-orange{background:#ffedd5;color:#9a3412}
img.preview{width:100%;border-radius:10px;margin-top:8px;max-height:180px;object-fit:cover;border:1px solid #e2e8f0}
.tabbar{position:fixed;bottom:0;left:0;right:0;background:#fff;display:flex;border-top:1px solid #e2e8f0;padding:6px 4px env(safe-area-inset-bottom,6px);z-index:10;box-shadow:0 -2px 10px rgba(0,0,0,.04)}
.tabbar button{position:relative;background:none;color:#64748b;font-size:11px;padding:6px 2px;margin:0;border-radius:10px;display:flex;flex-direction:column;align-items:center;gap:3px}
.tabbar button.active{color:#0f172a;background:#f1f5f9}
.tabbar button span.ico{font-size:18px;line-height:1}
.dot{position:absolute;top:4px;right:18%;background:#dc2626;color:#fff;font-size:10px;font-weight:800;padding:1px 5px;border-radius:10px;display:none}
.view{display:none}.view.active{display:block}
.empty{text-align:center;color:#94a3b8;padding:24px 12px;font-size:14px}
.ocr-status{display:none;background:#eff6ff;border:1px solid #bfdbfe;color:#1e40af;padding:10px;border-radius:10px;font-size:13px;font-weight:600;margin-top:8px;text-align:center}
.search-box{background:#f8fafc;border:1px solid #cbd5e1;padding:10px 12px;border-radius:10px;font-size:15px;margin-bottom:6px}
</style>
</head>
<body>

<h1>🚚 Fleet Fuel AI <span class="badge badge-blue" id="fleetCountBadge">0 mezzi</span></h1>
<div class="sub">Scansione Automatica Targhe & Scontrini Flotta</div>

<!-- VISTA 1: SCANSIONE & RIFORNIMENTO -->
<div id="view-add" class="view active">
  
  <!-- STEP 1: FOTO TARGA -->
  <div class="card">
    <h2>1. Identifica Furgone</h2>
    <label class="btn-scan" for="camPlate">📷 Scatta Foto alla Targa</label>
    <input type="file" id="camPlate" accept="image/*" capture="environment" style="display:none">
    <div id="plateOcrStatus" class="ocr-status"></div>
    <img id="previewPlate" class="preview" style="display:none" alt="Foto targa">

    <label>Oppure cerca e seleziona Targa *</label>
    <input type="text" id="quickSearchPlate" class="search-box" placeholder="🔍 Digita targa o modello..." oninput="filterSelectOptions('quickSearchPlate', 'fVehicle')">
    <select id="fVehicle"></select>
  </div>

  <!-- STEP 2: FOTO SCONTRINO -->
  <div class="card">
    <h2>2. Scansiona Scontrino Carburante</h2>
    <label class="btn-scan" style="background:linear-gradient(135deg,#0f172a,#334155)" for="camReceipt">🧾 Scatta Foto allo Scontrino</label>
    <input type="file" id="camReceipt" accept="image/*" capture="environment" style="display:none">
    <div id="receiptOcrStatus" class="ocr-status"></div>
    <img id="previewReceipt" class="preview" style="display:none" alt="Foto scontrino">

    <div class="row">
      <div>
        <label>Data *</label>
        <input type="date" id="fDate">
      </div>
      <div>
        <label>Km Furgone *</label>
        <input type="number" id="fKm" placeholder="es. 124500" inputmode="numeric">
      </div>
    </div>

    <div class="row">
      <div>
        <label>Litri (L) *</label>
        <input type="number" id="fLiters" step="0.01" placeholder="Auto / manuale" inputmode="decimal">
      </div>
      <div>
        <label>Prezzo €/L</label>
        <input type="number" id="fPrice" step="0.001" placeholder="Auto / manuale" inputmode="decimal">
      </div>
    </div>

    <label>Totale Pagato (€) *</label>
    <input type="number" id="fTotal" step="0.01" placeholder="Auto / manuale" inputmode="decimal">

    <label class="check-row">
      <input type="checkbox" id="fFull" checked>
      <div>
        <span>Pieno completo</span>
        <small>Calcola automaticamente la resa km/l del furgone</small>
      </div>
    </label>

    <label>Autista / Note</label>
    <input type="text" id="fNote" placeholder="Nome autista o gestore">

    <button class="btn-green" onclick="saveFuel()">💾 Salva Rifornimento</button>
    <button class="btn-wa" onclick="saveFuel(true)">📲 Salva e Invia in Sede (WhatsApp)</button>
  </div>
</div>

<!-- VISTA 2: STORICO -->
<div id="view-history" class="view">
  <div class="card">
    <label style="margin-top:0">Cerca per Targa, Autista o Data</label>
    <input type="text" id="historySearch" class="search-box" placeholder="🔍 Filtra storico (es. FG 482)..." oninput="renderHistory()">
  </div>
  <div id="historyList"></div>
</div>

<!-- VISTA 3: SCADENZE -->
<div id="view-deadlines" class="view">
  <div class="card">
    <h2>Nuova Scadenza Mezzo</h2>
    <label>Cerca Veicolo *</label>
    <input type="text" id="deadlineSearchPlate" class="search-box" placeholder="🔍 Filtra targa..." oninput="filterSelectOptions('deadlineSearchPlate', 'dVehicle')">
    <select id="dVehicle"></select>

    <div class="row">
      <div>
        <label>Tipo Scadenza *</label>
        <select id="dType">
          <option value="Revisione">Revisione</option>
          <option value="Assicurazione">Assicurazione</option>
          <option value="Bollo">Bollo</option>
          <option value="Tagliando">Tagliando</option>
          <option value="Tachigrafo">Tachigrafo</option>
          <option value="Gomme">Cambio Gomme</option>
        </select>
      </div>
      <div>
        <label>Data Scadenza *</label>
        <input type="date" id="dDate">
      </div>
    </div>

    <label>Note</label>
    <input type="text" id="dNote" placeholder="es. Revisione annuale o tagliando">

    <button class="btn-blue" onclick="addDeadline()">🔔 Salva Scadenza</button>
  </div>

  <div class="card">
    <h2>Scadenzario Flotta</h2>
    <div id="deadlineList"></div>
  </div>
</div>

<!-- VISTA 4: REPORT & CLOUD -->
<div id="view-stats" class="view">
  <div class="kpi">
    <div><small>Spesa Totale</small><b id="kpiCost">€ 0,00</b></div>
    <div><small>Litri Erogati</small><b id="kpiLiters">0,0 L</b></div>
    <div><small>Media Flotta</small><b id="kpiAvg">-- km/l</b></div>
    <div><small>Rifornimenti</small><b id="kpiCount">0</b></div>
  </div>

  <div class="card">
    <h2>Esporta & Condividi Report</h2>
    <button class="btn-blue" onclick="exportCSV()">📊 Scarica File Excel Aziendale (CSV)</button>
    <button class="btn-wa" onclick="shareSummaryWA()">📲 Invia Riepilogo WhatsApp</button>
  </div>

  <div class="card">
    <h2>Consumi per Furgone</h2>
    <input type="text" id="statsSearch" class="search-box" placeholder="🔍 Cerca targa nel report..." oninput="renderStats()">
    <div id="vehicleStats"></div>
  </div>
</div>

<!-- VISTA 5: GESTIONE FLOTTA (+50 MEZZI) -->
<div id="view-vehicles" class="view">
  <div class="card">
    <h2>Aggiungi Singolo Furgone</h2>
    <div class="row">
      <div>
